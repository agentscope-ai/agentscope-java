    "mcpResult": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "agent.mcp_tool_result"
        },
        "processed_at": {
          "type": "string",
          "format": "date-time"
        },
        "content": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/text"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "is_error": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "mcp_tool_use_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "type",
        "processed_at",
        "mcp_tool_use_id"
      ],
      "additionalProperties": false
    },
    "persisted": {
      "oneOf": [
        {
          "$ref": "#/$defs/userMessage"
        },
        {
          "$ref": "#/$defs/userInterrupt"
        },
        {
          "$ref": "#/$defs/userCustomResult"
        },
        {
          "$ref": "#/$defs/userConfirmation"
        },
        {
          "$ref": "#/$defs/agentMessage"
        },
        {
          "$ref": "#/$defs/running"
        },
        {
          "$ref": "#/$defs/terminated"
        },
        {
          "$ref": "#/$defs/rescheduled"
        },
        {
          "$ref": "#/$defs/thinking"
        },
        {
          "$ref": "#/$defs/compacted"
        },
        {
          "$ref": "#/$defs/modelStart"
        },
        {
          "$ref": "#/$defs/idle"
        },
        {
          "$ref": "#/$defs/error"
        },
        {
          "$ref": "#/$defs/modelEnd"
        },
        {
          "$ref": "#/$defs/customUse"
        },
        {
          "$ref": "#/$defs/toolUse"
        },
        {
          "$ref": "#/$defs/mcpUse"
        },
        {
          "$ref": "#/$defs/toolResult"
        },
        {
          "$ref": "#/$defs/mcpResult"
        }
      ]
    },
    "eventStart": {
      "type": "object",
      "properties": {
        "type": {
          "const": "event_start"
        },
        "event": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "agent.message",
                "agent.thinking"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "event"
      ],
      "additionalProperties": false
    },
    "eventDelta": {
      "type": "object",
      "properties": {
        "type": {
          "const": "event_delta"
        },
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "delta": {
          "type": "object",
          "properties": {
            "type": {
              "const": "content_delta"
            },
            "index": {
              "type": "integer",
              "minimum": 0
            },
            "content": {
              "$ref": "#/$defs/text"
            }
          },
          "required": [
            "type",
            "index",
            "content"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "event_id",
        "delta"
      ],
      "additionalProperties": false
    },
    "sendRequest": {
      "type": "object",
      "properties": {
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "user.message"
                  },
                  "content": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/text"
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "type",
                  "content"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "user.interrupt"
                  },
                  "session_thread_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "user.custom_tool_result"
                  },
                  "custom_tool_use_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "content": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/text"
                    }
                  },
                  "is_error": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  }
                },
                "required": [
                  "type",
                  "custom_tool_use_id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "user.tool_confirmation"
                  },
                  "tool_use_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "result": {
                    "enum": [
                      "allow",
                      "deny"
                    ]
                  },
                  "deny_message": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "type",
                  "tool_use_id",
                  "result"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "events"
      ],
      "additionalProperties": false
    }
  }
}
