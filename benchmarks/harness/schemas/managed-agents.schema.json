    "mcpUse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "agent.mcp_tool_use"
        },
        "processed_at": {
          "type": "string",
          "format": "date-time"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "object"
        },
        "session_thread_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "evaluated_permission": {
          "enum": [
            "allow",
            "ask",
            "deny",
            null
          ]
        },
        "mcp_server_name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "type",
        "processed_at",
        "name",
        "input",
        "mcp_server_name"
      ],
      "additionalProperties": false
    },
    "toolResult": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "agent.tool_result"
        },
        "processed_at": {
          "type": "string",
          "format": "date-time"
        },
        "content": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/text"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "is_error": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "tool_use_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "type",
        "processed_at",
        "tool_use_id"
