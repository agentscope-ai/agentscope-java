{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Managed Agents text profile v1",
  "description": "An explicit subset, reviewed 2026-11-07. See upstream.json and docs/agent-protocol.md. No eval metadata belongs in these events.",
  "oneOf": [
    {
      "$ref": "#/$defs/persisted"
    },
    {
      "$ref": "#/$defs/eventStart"
    },
    {
      "$ref": "#/$defs/eventDelta"
    }
  ],
  "$defs": {
    "text": {
      "type": "object",
      "properties": {
        "type": {
          "const": "text"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "additionalProperties": false
    },
    "redacted": {
      "type": "object",
      "properties": {
        "type": {
          "const": "redacted"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "stopReason": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "end_turn"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "budget_reached"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "retries_exhausted"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "refusal"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "requires_action"
            },
            "event_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "type",
            "event_ids"
          ],
          "additionalProperties": false
        }
      ]
    },
    "unknownError": {
      "type": "object",
      "properties": {
        "type": {
          "const": "unknown_error"
        },
        "message": {
          "type": "string"
        },
        "retry_status": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "retrying",
                "exhausted",
                "terminal"
              ]
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "message",
        "retry_status"
      ],
      "additionalProperties": false
    },
    "modelUsage": {
      "type": "object",
      "properties": {
        "cache_creation_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_read_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "speed": {
          "enum": [
            "standard",
            "fast",
            null
          ]
        }
      },
      "required": [
        "cache_creation_input_tokens",
        "cache_read_input_tokens",
        "input_tokens",
        "output_tokens"
      ],
      "additionalProperties": false
    },
    "userMessage": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "user.message"
        },
        "processed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      },
      "required": [
        "id",
        "type",
        "content"
      ],
      "additionalProperties": false
    },
    "userInterrupt": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "user.interrupt"
        },
        "processed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "session_thread_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "type"
      ],
      "additionalProperties": false
    },
    "userCustomResult": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "user.custom_tool_result"
        },
        "processed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "custom_tool_use_id": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/text"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "is_error": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "session_thread_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "type",
        "custom_tool_use_id"
      ],
      "additionalProperties": false
    },
    "userConfirmation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "user.tool_confirmation"
        },
        "processed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "tool_use_id": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": [
            "allow",
            "deny"
          ]
        },
        "deny_message": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_thread_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "type",
        "tool_use_id",
        "result"
      ],
      "additionalProperties": false
    },
    "agentMessage": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "agent.message"
        },
        "processed_at": {
          "type": "string",
          "format": "date-time"
        },
        "content": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/text"
              },
              {
                "$ref": "#/$defs/redacted"
              }
            ]
          }
        }
      },
      "required": [
        "id",
        "type",
        "processed_at",
        "content"
      ],
      "additionalProperties": false
    },
    "running": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "session.status_running"
        },
        "processed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "type",
        "processed_at"
      ],
      "additionalProperties": false
    },
    "terminated": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "session.status_terminated"
        },
        "processed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "type",
        "processed_at"
      ],
      "additionalProperties": false
    },
    "rescheduled": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "session.status_rescheduled"
        },
        "processed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "type",
        "processed_at"
      ],
      "additionalProperties": false
    },
    "thinking": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "agent.thinking"
        },
        "processed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "type",
        "processed_at"
      ],
      "additionalProperties": false
    },
    "compacted": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "agent.thread_context_compacted"
