          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "type",
        "processed_at"
      ],
      "additionalProperties": false
    },
    "modelStart": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "span.model_request_start"
        },
        "processed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "type",
        "processed_at"
      ],
      "additionalProperties": false
    },
    "idle": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "session.status_idle"
        },
        "processed_at": {
          "type": "string",
          "format": "date-time"
        },
        "stop_reason": {
          "$ref": "#/$defs/stopReason"
        },
        "stop_details": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "refusal"
                },
                "category": {
                  "enum": [
                    "cyber",
                    "bio",
                    "frontier_llm",
                    "reasoning_extraction",
                    "general_harms",
                    null
                  ]
                },
                "explanation": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "id",
        "type",
        "processed_at",
        "stop_reason"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "session.error"
        },
        "processed_at": {
          "type": "string",
          "format": "date-time"
        },
        "error": {
          "$ref": "#/$defs/unknownError"
        }
      },
      "required": [
        "id",
        "type",
        "processed_at",
        "error"
      ],
      "additionalProperties": false
    },
    "modelEnd": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "span.model_request_end"
        },
        "processed_at": {
          "type": "string",
          "format": "date-time"
        },
        "model_request_start_id": {
          "type": "string",
          "minLength": 1
        },
        "model_usage": {
          "$ref": "#/$defs/modelUsage"
        },
        "is_error": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "type",
        "processed_at",
        "model_request_start_id",
        "model_usage"
      ],
      "additionalProperties": false
    },
    "customUse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "agent.custom_tool_use"
        },
        "processed_at": {
          "type": "string",
          "format": "date-time"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "object"
        },
        "session_thread_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
