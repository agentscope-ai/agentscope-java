<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!-- No reactor parent: resolve only the dependencies a downstream application receives. -->
    <groupId>io.agentscope.it</groupId>
    <artifactId>starter-runtime</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <starter.artifactId>agentscope-spring-boot-starter</starter.artifactId>
        <scenario>base</scenario>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
            <version>@spring-boot.version@</version>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>${starter.artifactId}</artifactId>
            <version>@project.version@</version>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>explicit-extension</id>
            <properties>
                <scenario>explicit-extension</scenario>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>io.agentscope</groupId>
                    <artifactId>agentscope-extensions-agui</artifactId>
                    <version>@project.version@</version>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>agui-starter</id>
            <properties>
                <starter.artifactId>agentscope-agui-spring-boot-starter</starter.artifactId>
                <scenario>agui-starter</scenario>
            </properties>
        </profile>
    </profiles>

    <build>
        <!-- Keep each dependency scenario's compiled classes and executable JAR isolated. -->
        <directory>${project.basedir}/target/${scenario}</directory>
        <finalName>starter-runtime-${scenario}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>@maven-compiler-plugin.version@</version>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>@spring-boot.version@</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>run-packaged-application</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>java</executable>
                            <arguments>
                                <argument>-jar</argument>
                                <argument>${project.build.directory}/${project.build.finalName}.jar</argument>
                                <argument>${scenario}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
