<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.agentscope</groupId>
        <artifactId>agentscope-extensions</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>agentscope-extensions-kotlin</artifactId>
    <name>AgentScope Java - Extensions - Kotlin</name>
    <description>Kotlin coroutine extensions for AgentScope: exposes the Reactor-based agent APIs as
        suspend functions and Flow, so Kotlin users rarely need to touch Mono/Flux directly.</description>

    <properties>
        <!--
          Version of the Kotlin compiler plugin. agentscope-dependencies-bom is consumed with
          scope=import, which propagates dependencyManagement but NOT properties, so the plugin
          version has to be declared locally. Keep in sync with kotlin.version in the BOM.
          Coroutine artifact versions do come from the BOM and are therefore omitted below.

          Must stay >= the Kotlin version used to build our Kotlin-based dependencies: the
          compiler refuses metadata newer than itself, and kotlinx-coroutines 1.10.x ships
          metadata 2.1 while okhttp/okio ship 2.2.
        -->
        <kotlin.version>2.2.0</kotlin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-core</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
          Needed only for the HarnessAgent extensions. Declared as provided so core-only users
          do not pull in harness; the HarnessAgent extension functions live in their own file
          (and therefore their own class file), so they are simply never loaded when harness is
          absent from the runtime classpath.
        -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-harness</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <version>${kotlin.version}</version>
        </dependency>

        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kotlinx-coroutines-core</artifactId>
        </dependency>

        <!-- Reactor <-> coroutine bridge: awaitSingle / awaitFirstOrNull / asFlow -->
        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kotlinx-coroutines-reactor</artifactId>
        </dependency>

        <!-- Shared test fixtures from agentscope-core (MockModel). -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-core</artifactId>
            <version>${revision}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>${project.basedir}/src/main/kotlin</sourceDirectory>
        <testSourceDirectory>${project.basedir}/src/test/kotlin</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <configuration>
                    <jvmTarget>${java.version}</jvmTarget>
                    <args>
                        <!-- Treat platform types from the Java API as non-null by default. -->
                        <arg>-Xjsr305=strict</arg>
                    </args>
                </configuration>
                <executions>
                    <execution>
                        <id>compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>test-compile</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
