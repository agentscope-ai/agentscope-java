<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.agentscope</groupId>
        <artifactId>agentscope-extensions</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>agentscope-extensions-durable-jdbc</artifactId>
    <name>AgentScope Durable - JDBC</name>
    <properties>
        <sqlite.version>3.47.1.0</sqlite.version>
    </properties>
    <dependencies>
        <dependency><groupId>io.agentscope</groupId><artifactId>agentscope-durable-runtime</artifactId><version>${revision}</version><type>test-jar</type><scope>test</scope></dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-durable-runtime</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.version}</version>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
    <build><plugins><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId>
      <executions><execution><goals><goal>test-jar</goal></goals></execution></executions>
    </plugin></plugins></build>
</project>
