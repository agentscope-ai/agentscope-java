<?xml version="1.0" encoding="UTF-8"?>
<!-- Keep test logging quiet: warnings and errors only, to stderr -->
<configuration>
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <!-- Accumulator WARNs are expected test fixtures (asserted through a
         ListAppender attached directly to the logger); additivity=false
         keeps them off stderr without gating the events themselves. -->
    <logger name="io.agentscope.core.agent.accumulator" additivity="false"/>
    <root level="WARN">
        <appender-ref ref="STDERR"/>
    </root>
</configuration>
