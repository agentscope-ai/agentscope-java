<?xml version="1.0" encoding="UTF-8"?>
<!-- Keep test logging quiet: warnings and errors only, to stderr -->
<configuration>
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <!-- INFO root keeps unrelated log assertions live; the accumulator
         package is pinned to WARN so parse-warning tests stay quiet. -->
    <root level="INFO">
        <appender-ref ref="STDERR"/>
    </root>
    <logger name="io.agentscope.core.agent.accumulator" level="WARN"/>
</configuration>
