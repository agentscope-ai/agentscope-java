{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentcore.invalid/managed-agents/0.1.0/preview.schema.json",
  "title": "Ephemeral text preview protocol",
  "$defs": {
    "InterestRequest": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "common.schema.json#/$defs/Version"
        },
        "scope": {
          "$ref": "common.schema.json#/$defs/Scope"
        },
        "turnId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "fence": {
          "$ref": "common.schema.json#/$defs/Fence"
        },
        "modelCallId": {
          "$ref": "common.schema.json#/$defs/Id"
        }
      },
      "required": [
        "protocolVersion",
        "scope",
        "turnId",
        "fence",
        "modelCallId"
      ],
      "additionalProperties": false
    },
    "InterestResponse": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": "0.1.0"
        },
        "scope": {
          "$ref": "common.schema.json#/$defs/Scope"
        },
        "turnId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "interested": {
          "type": "boolean"
        }
      },
      "required": [
        "protocolVersion",
        "scope",
        "turnId",
        "interested"
      ],
      "additionalProperties": false
    },
    "PublishRequest": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "common.schema.json#/$defs/Version"
        },
        "scope": {
          "$ref": "common.schema.json#/$defs/Scope"
        },
        "turnId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "fence": {
          "$ref": "common.schema.json#/$defs/Fence"
        },
        "modelCallId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "messageId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "sequence": {
          "$ref": "common.schema.json#/$defs/UInt"
        },
        "chunks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      },
      "required": [
        "protocolVersion",
        "scope",
        "turnId",
        "fence",
        "modelCallId",
        "messageId",
        "sequence",
        "chunks"
      ],
      "additionalProperties": false
    },
    "PublishResponse": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": "0.1.0"
        },
        "scope": {
          "$ref": "common.schema.json#/$defs/Scope"
        },
        "turnId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "accepted": {
          "type": "boolean"
        }
      },
      "required": [
        "protocolVersion",
        "scope",
        "turnId",
        "accepted"
      ],
      "additionalProperties": false
    }
  }
}
