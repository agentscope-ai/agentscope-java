{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentcore.invalid/managed-agents/0.1.0/recovery.schema.json",
  "title": "Managed Agents recovery protocol 0.1.0",
  "$defs": {
    "RecoveryRequest": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "common.schema.json#/$defs/Version"
        },
        "scope": {
          "$ref": "common.schema.json#/$defs/Scope"
        },
        "turnId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "fence": {
          "$ref": "common.schema.json#/$defs/Fence"
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "cursor": {
          "$ref": "recovery.schema.json#/$defs/RecoveryCursor"
        }
      },
      "required": [
        "protocolVersion",
        "scope",
        "turnId",
        "fence"
      ],
      "additionalProperties": false,
      "dependentRequired": {
        "cursor": [
          "pageSize"
        ]
      }
    },
    "PendingInput": {
      "type": "object",
      "properties": {
        "inputId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "sequence": {
          "$ref": "common.schema.json#/$defs/Positive"
        },
        "type": {
          "type": "string",
          "enum": [
            "message",
            "interaction_response",
            "cancel"
          ]
        },
        "content": {
          "$ref": "common.schema.json#/$defs/Content"
        },
        "actionId": {
          "$ref": "common.schema.json#/$defs/Id"
        }
      },
      "required": [
        "inputId",
        "sequence",
        "type",
        "content"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "interaction_response"
              }
            }
          },
          "then": {
            "required": [
              "actionId"
            ]
          },
          "else": {
            "not": {
              "required": [
                "actionId"
              ]
            }
          }
        }
      ]
    },
    "RecoveryBundle": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "common.schema.json#/$defs/Version"
        },
        "scope": {
          "$ref": "common.schema.json#/$defs/Scope"
        },
        "turnId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "snapshotId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "capturedAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "brainRevision": {
          "$ref": "common.schema.json#/$defs/UInt"
        },
        "nativeState": {
          "$ref": "common.schema.json#/$defs/NativeState"
        },
        "pendingInputs": {
          "type": "array",
          "items": {
            "$ref": "recovery.schema.json#/$defs/PendingInput"
          },
          "minItems": 0,
          "maxItems": 4096
        },
        "inputApplications": {
          "type": "array",
          "items": {
            "$ref": "commit.schema.json#/$defs/InputApplication"
          },
          "minItems": 0,
          "maxItems": 4096
        },
        "toolCalls": {
          "type": "array",
          "items": {
            "$ref": "commit.schema.json#/$defs/NativeCall"
          },
          "minItems": 0,
          "maxItems": 4096
        },
        "toolOperations": {
          "type": "array",
          "items": {
            "$ref": "tools.schema.json#/$defs/Operation"
          },
          "minItems": 0,
          "maxItems": 4096
        },
        "acceptedResults": {
          "type": "array",
          "items": {
            "$ref": "tools.schema.json#/$defs/Result"
          },
          "minItems": 0,
          "maxItems": 4096
        },
        "resultApplications": {
          "type": "array",
          "items": {
            "$ref": "commit.schema.json#/$defs/ResultApplication"
          },
          "minItems": 0,
          "maxItems": 4096
        },
        "modelUpdates": {
          "type": "array",
          "items": {
            "$ref": "commit.schema.json#/$defs/ModelUpdate"
          },
          "minItems": 0,
          "maxItems": 4096
        },
        "interactionUpdates": {
          "type": "array",
          "items": {
            "$ref": "commit.schema.json#/$defs/InteractionUpdate"
          },
          "minItems": 0,
          "maxItems": 4096
        },
        "suspension": {
          "$ref": "commit.schema.json#/$defs/Suspension"
        },
        "terminal": {
          "$ref": "commit.schema.json#/$defs/Terminal"
        }
      },
      "required": [
        "protocolVersion",
        "scope",
        "turnId",
        "snapshotId",
        "capturedAt",
        "brainRevision",
        "pendingInputs",
        "inputApplications",
        "toolCalls",
        "toolOperations",
        "acceptedResults",
        "resultApplications",
        "modelUpdates",
        "interactionUpdates"
      ],
      "additionalProperties": false,
      "not": {
        "required": [
          "suspension",
          "terminal"
        ]
      }
    },
    "RecoveryResponse": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "common.schema.json#/$defs/Version"
        },
        "scope": {
          "$ref": "common.schema.json#/$defs/Scope"
        },
        "turnId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "snapshotId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "bundle": {
          "$ref": "recovery.schema.json#/$defs/RecoveryBundle"
        },
        "bundleRef": {
          "$ref": "common.schema.json#/$defs/ObjectRef"
        },
        "nextCursor": {
          "$ref": "recovery.schema.json#/$defs/RecoveryCursor"
        }
      },
      "required": [
        "protocolVersion",
        "scope",
        "turnId",
        "snapshotId"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "bundle"
          ]
        },
        {
          "required": [
            "bundleRef"
          ]
        }
      ]
    },
    "RecoveryCursor": {
      "type": "object",
      "properties": {
        "afterRevision": {
          "$ref": "common.schema.json#/$defs/UInt"
        },
        "throughRevision": {
          "$ref": "common.schema.json#/$defs/UInt"
        }
      },
      "required": [
        "afterRevision",
        "throughRevision"
      ],
      "additionalProperties": false
    }
  }
}
