{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentcore.invalid/managed-agents/0.1.0/execution.schema.json",
  "title": "Managed Agents execution protocol 0.1.0",
  "$defs": {
    "Trigger": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "ready"
            },
            "messageId": {
              "$ref": "common.schema.json#/$defs/Id"
            },
            "queueVersion": {
              "$ref": "common.schema.json#/$defs/Positive"
            }
          },
          "required": [
            "kind",
            "messageId",
            "queueVersion"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "resume"
            },
            "messageId": {
              "$ref": "common.schema.json#/$defs/Id"
            },
            "suspensionId": {
              "$ref": "common.schema.json#/$defs/Id"
            },
            "suspensionEpoch": {
              "$ref": "common.schema.json#/$defs/Positive"
            }
          },
          "required": [
            "kind",
            "messageId",
            "suspensionId",
            "suspensionEpoch"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ClaimRequest": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "common.schema.json#/$defs/Version"
        },
        "scope": {
          "$ref": "common.schema.json#/$defs/Scope"
        },
        "turnId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "claimId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "owner": {
          "$ref": "common.schema.json#/$defs/Owner"
        },
        "trigger": {
          "$ref": "execution.schema.json#/$defs/Trigger"
        },
        "harnessType": {
          "enum": [
            "agentscope-java",
            "pi",
            "pi-durable",
            "codex"
          ]
        }
      },
      "required": [
        "protocolVersion",
        "scope",
        "claimId",
        "owner",
        "trigger",
        "harnessType"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "trigger": {
                "properties": {
                  "kind": {
                    "const": "resume"
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "turnId"
            ]
          }
        }
      ]
    },
    "ClaimReceipt": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "common.schema.json#/$defs/Version"
        },
        "scope": {
          "$ref": "common.schema.json#/$defs/Scope"
        },
        "turnId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "claimId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "fence": {
          "$ref": "common.schema.json#/$defs/Fence"
        },
        "expiresAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        }
      },
      "required": [
        "protocolVersion",
        "scope",
        "turnId",
        "claimId",
        "fence",
        "expiresAt"
      ],
      "additionalProperties": false
    },
    "RenewRequest": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "common.schema.json#/$defs/Version"
        },
        "scope": {
          "$ref": "common.schema.json#/$defs/Scope"
        },
        "turnId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "renewalId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "fence": {
          "$ref": "common.schema.json#/$defs/Fence"
        }
      },
      "required": [
        "protocolVersion",
        "scope",
        "turnId",
        "renewalId",
        "fence"
      ],
      "additionalProperties": false
    },
    "RenewReceipt": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "common.schema.json#/$defs/Version"
        },
        "scope": {
          "$ref": "common.schema.json#/$defs/Scope"
        },
        "turnId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "renewalId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "fence": {
          "$ref": "common.schema.json#/$defs/Fence"
        },
        "expiresAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "serverTime": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        }
      },
      "required": [
        "protocolVersion",
        "scope",
        "turnId",
        "renewalId",
        "fence",
        "expiresAt",
        "serverTime"
      ],
      "additionalProperties": false
    },
    "DeferRequest": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "common.schema.json#/$defs/Version"
        },
        "scope": {
          "$ref": "common.schema.json#/$defs/Scope"
        },
        "turnId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "deferralId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "trigger": {
          "$ref": "execution.schema.json#/$defs/Trigger"
        },
        "retryAfterMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300000
        },
        "reason": {
          "type": "string",
          "enum": [
            "capacity",
            "execution_busy",
            "temporarily_unavailable"
          ]
        },
        "fence": {
          "$ref": "common.schema.json#/$defs/Fence"
        }
      },
      "required": [
        "protocolVersion",
        "scope",
        "turnId",
        "deferralId",
        "trigger",
        "retryAfterMs",
        "reason"
      ],
      "additionalProperties": false
    },
    "DeferReceipt": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "common.schema.json#/$defs/Version"
        },
        "scope": {
          "$ref": "common.schema.json#/$defs/Scope"
        },
        "turnId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "deferralId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "messageId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "outcome": {
          "const": "deferred"
        },
        "notBefore": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        }
      },
      "required": [
        "protocolVersion",
        "scope",
        "turnId",
        "deferralId",
        "messageId",
        "outcome",
        "notBefore"
      ],
      "additionalProperties": false
    },
    "Ready": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "common.schema.json#/$defs/Version"
        },
        "messageId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "kind": {
          "const": "session.ready"
        },
        "scope": {
          "$ref": "common.schema.json#/$defs/Scope"
        },
        "queueVersion": {
          "$ref": "common.schema.json#/$defs/Positive"
        }
      },
      "required": [
        "protocolVersion",
        "messageId",
        "kind",
        "scope",
        "queueVersion"
      ],
      "additionalProperties": false
    },
    "Resume": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "common.schema.json#/$defs/Version"
        },
        "messageId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "kind": {
          "const": "turn.resume"
        },
        "scope": {
          "$ref": "common.schema.json#/$defs/Scope"
        },
        "turnId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "suspensionId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "suspensionEpoch": {
          "$ref": "common.schema.json#/$defs/Positive"
        },
        "publicationSequence": {
          "$ref": "common.schema.json#/$defs/Positive"
        }
      },
      "required": [
        "protocolVersion",
        "messageId",
        "kind",
        "scope",
        "turnId",
        "suspensionId",
        "suspensionEpoch",
        "publicationSequence"
      ],
      "additionalProperties": false
    }
  }
}
