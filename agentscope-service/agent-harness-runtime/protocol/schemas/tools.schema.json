{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentcore.invalid/managed-agents/0.1.0/tools.schema.json",
  "title": "Managed Agents tools protocol 0.1.0",
  "$defs": {
    "Operation": {
      "type": "object",
      "properties": {
        "operationId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "taskId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "executionId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "nativeCallIds": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/Id"
          },
          "minItems": 1,
          "maxItems": 256
        },
        "toolName": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "arguments": {
          "$ref": "common.schema.json#/$defs/Content"
        },
        "configurationRef": {
          "$ref": "common.schema.json#/$defs/ObjectRef"
        },
        "batch": {
          "type": "object",
          "properties": {
            "parentTaskId": {
              "$ref": "common.schema.json#/$defs/Id"
            },
            "ordinal": {
              "$ref": "common.schema.json#/$defs/UInt"
            }
          },
          "required": [
            "parentTaskId",
            "ordinal"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "operationId",
        "taskId",
        "executionId",
        "nativeCallIds",
        "toolName",
        "arguments",
        "configurationRef"
      ],
      "additionalProperties": false
    },
    "OutputCoverage": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "none",
            "complete",
            "gapped"
          ]
        },
        "throughSourceSeq": {
          "$ref": "common.schema.json#/$defs/UInt"
        },
        "byteLength": {
          "$ref": "common.schema.json#/$defs/UInt"
        },
        "gapEventIds": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/Id"
          },
          "minItems": 0,
          "maxItems": 256
        }
      },
      "required": [
        "mode",
        "throughSourceSeq",
        "byteLength"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "gapped"
              }
            }
          },
          "then": {
            "required": [
              "gapEventIds"
            ],
            "properties": {
              "gapEventIds": {
                "minItems": 1
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "gapEventIds"
              ]
            }
          }
        }
      ]
    },
    "Result": {
      "type": "object",
      "properties": {
        "resultId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "taskId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "executionId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "status": {
          "type": "string",
          "enum": [
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        "content": {
          "$ref": "common.schema.json#/$defs/Content"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/ObjectRef"
          },
          "minItems": 0,
          "maxItems": 256
        },
        "output": {
          "$ref": "tools.schema.json#/$defs/OutputCoverage"
        }
      },
      "required": [
        "resultId",
        "taskId",
        "executionId",
        "status",
        "content",
        "artifacts",
        "output"
      ],
      "additionalProperties": false
    },
    "ExecuteTool": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "common.schema.json#/$defs/Version"
        },
        "messageId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "kind": {
          "const": "tool.execute"
        },
        "scope": {
          "$ref": "common.schema.json#/$defs/Scope"
        },
        "turnId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "authorizationCommitId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "operation": {
          "$ref": "tools.schema.json#/$defs/Operation"
        }
      },
      "required": [
        "protocolVersion",
        "messageId",
        "kind",
        "scope",
        "turnId",
        "authorizationCommitId",
        "operation"
      ],
      "additionalProperties": false
    },
    "CancelTool": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "common.schema.json#/$defs/Version"
        },
        "messageId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "kind": {
          "const": "tool.cancel"
        },
        "scope": {
          "$ref": "common.schema.json#/$defs/Scope"
        },
        "turnId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "taskId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "executionId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "protocolVersion",
        "messageId",
        "kind",
        "scope",
        "turnId",
        "taskId",
        "executionId",
        "reason"
      ],
      "additionalProperties": false
    },
    "ReplayToolEvents": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "common.schema.json#/$defs/Version"
        },
        "messageId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "kind": {
          "const": "tool.replay"
        },
        "scope": {
          "$ref": "common.schema.json#/$defs/Scope"
        },
        "turnId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "taskId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "executionId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "requestId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "fromSourceSeq": {
          "$ref": "common.schema.json#/$defs/Positive"
        }
      },
      "required": [
        "protocolVersion",
        "messageId",
        "kind",
        "scope",
        "turnId",
        "taskId",
        "executionId",
        "requestId",
        "fromSourceSeq"
      ],
      "additionalProperties": false
    },
    "ToolStateRequest": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "common.schema.json#/$defs/Version"
        },
        "scope": {
          "$ref": "common.schema.json#/$defs/Scope"
        },
        "turnId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "taskId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "executionId": {
          "$ref": "common.schema.json#/$defs/Id"
        }
      },
      "required": [
        "protocolVersion",
        "scope",
        "turnId",
        "taskId",
        "executionId"
      ],
      "additionalProperties": false
    },
    "ToolStateResponse": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "common.schema.json#/$defs/Version"
        },
        "scope": {
          "$ref": "common.schema.json#/$defs/Scope"
        },
        "turnId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "taskId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "executionId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "state": {
          "type": "string",
          "enum": [
            "authorized",
            "admitted",
            "starting",
            "running",
            "unknown",
            "result_pending",
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        "observedAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "cancelRequested": {
          "type": "boolean"
        },
        "result": {
          "$ref": "tools.schema.json#/$defs/Result"
        }
      },
      "required": [
        "protocolVersion",
        "scope",
        "turnId",
        "taskId",
        "executionId",
        "state",
        "observedAt",
        "cancelRequested"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "succeeded",
                  "failed",
                  "cancelled"
                ]
              }
            }
          },
          "then": {
            "required": [
              "result"
            ]
          },
          "else": {
            "not": {
              "required": [
                "result"
              ]
            }
          }
        }
      ]
    },
    "EventReceipt": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "common.schema.json#/$defs/Version"
        },
        "scope": {
          "$ref": "common.schema.json#/$defs/Scope"
        },
        "taskId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "executionId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "eventId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "contentHash": {
          "$ref": "common.schema.json#/$defs/Hash"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "buffered",
            "applied"
          ]
        },
        "throughSourceSeq": {
          "$ref": "common.schema.json#/$defs/UInt"
        },
        "acceptedResultIds": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/Id"
          },
          "minItems": 0,
          "maxItems": 256
        }
      },
      "required": [
        "protocolVersion",
        "scope",
        "taskId",
        "executionId",
        "eventId",
        "contentHash",
        "outcome",
        "throughSourceSeq",
        "acceptedResultIds"
      ],
      "additionalProperties": false
    },
    "ToolCommand": {
      "oneOf": [
        {
          "$ref": "tools.schema.json#/$defs/ExecuteTool"
        },
        {
          "$ref": "tools.schema.json#/$defs/CancelTool"
        },
        {
          "$ref": "tools.schema.json#/$defs/ReplayToolEvents"
        }
      ]
    },
    "ToolEvent": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "protocolVersion": {
              "$ref": "common.schema.json#/$defs/Version"
            },
            "messageId": {
              "$ref": "common.schema.json#/$defs/Id"
            },
            "kind": {
              "const": "tool.event"
            },
            "scope": {
              "$ref": "common.schema.json#/$defs/Scope"
            },
            "turnId": {
              "$ref": "common.schema.json#/$defs/Id"
            },
            "taskId": {
              "$ref": "common.schema.json#/$defs/Id"
            },
            "executionId": {
              "$ref": "common.schema.json#/$defs/Id"
            },
            "sourceSeq": {
              "$ref": "common.schema.json#/$defs/Positive"
            },
            "type": {
              "const": "tool.delta"
            },
            "data": {
              "type": "object",
              "properties": {
                "offset": {
                  "$ref": "common.schema.json#/$defs/UInt"
                },
                "nextOffset": {
                  "$ref": "common.schema.json#/$defs/UInt"
                },
                "dataBase64": {
                  "type": "string",
                  "contentEncoding": "base64",
                  "maxLength": 21848
                }
              },
              "required": [
                "offset",
                "nextOffset",
                "dataBase64"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "protocolVersion",
            "messageId",
            "kind",
            "scope",
            "turnId",
            "taskId",
            "executionId",
            "sourceSeq",
            "type",
            "data"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "protocolVersion": {
              "$ref": "common.schema.json#/$defs/Version"
            },
            "messageId": {
              "$ref": "common.schema.json#/$defs/Id"
            },
            "kind": {
              "const": "tool.event"
            },
            "scope": {
              "$ref": "common.schema.json#/$defs/Scope"
            },
            "turnId": {
              "$ref": "common.schema.json#/$defs/Id"
            },
            "taskId": {
              "$ref": "common.schema.json#/$defs/Id"
            },
            "executionId": {
              "$ref": "common.schema.json#/$defs/Id"
            },
            "sourceSeq": {
              "$ref": "common.schema.json#/$defs/Positive"
            },
            "type": {
              "const": "tool.progress"
            },
            "data": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              },
              "required": [
                "message"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "protocolVersion",
            "messageId",
            "kind",
            "scope",
            "turnId",
            "taskId",
            "executionId",
            "sourceSeq",
            "type",
            "data"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "protocolVersion": {
              "$ref": "common.schema.json#/$defs/Version"
            },
            "messageId": {
              "$ref": "common.schema.json#/$defs/Id"
            },
            "kind": {
              "const": "tool.event"
            },
            "scope": {
              "$ref": "common.schema.json#/$defs/Scope"
            },
            "turnId": {
              "$ref": "common.schema.json#/$defs/Id"
            },
            "taskId": {
              "$ref": "common.schema.json#/$defs/Id"
            },
            "executionId": {
              "$ref": "common.schema.json#/$defs/Id"
            },
            "sourceSeq": {
              "$ref": "common.schema.json#/$defs/Positive"
            },
            "type": {
              "const": "tool.output_gap"
            },
            "data": {
              "type": "object",
              "properties": {
                "fromOffset": {
                  "$ref": "common.schema.json#/$defs/UInt"
                },
                "toOffset": {
                  "$ref": "common.schema.json#/$defs/UInt"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                }
              },
              "required": [
                "fromOffset",
                "toOffset",
                "reason"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "protocolVersion",
            "messageId",
            "kind",
            "scope",
            "turnId",
            "taskId",
            "executionId",
            "sourceSeq",
            "type",
            "data"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "protocolVersion": {
              "$ref": "common.schema.json#/$defs/Version"
            },
            "messageId": {
              "$ref": "common.schema.json#/$defs/Id"
            },
            "kind": {
              "const": "tool.event"
            },
            "scope": {
              "$ref": "common.schema.json#/$defs/Scope"
            },
            "turnId": {
              "$ref": "common.schema.json#/$defs/Id"
            },
            "taskId": {
              "$ref": "common.schema.json#/$defs/Id"
            },
            "executionId": {
              "$ref": "common.schema.json#/$defs/Id"
            },
            "sourceSeq": {
              "$ref": "common.schema.json#/$defs/Positive"
            },
            "type": {
              "const": "tool.result"
            },
            "data": {
              "type": "object",
              "properties": {
                "result": {
                  "$ref": "tools.schema.json#/$defs/Result"
                }
              },
              "required": [
                "result"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "protocolVersion",
            "messageId",
            "kind",
            "scope",
            "turnId",
            "taskId",
            "executionId",
            "sourceSeq",
            "type",
            "data"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
