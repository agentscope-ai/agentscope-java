{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentcore.invalid/managed-agents/0.1.0/runtime.schema.json",
  "title": "Session Service runtime operations",
  "$defs": {
    "FencedRequest": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "common.schema.json#/$defs/Version"
        },
        "scope": {
          "$ref": "common.schema.json#/$defs/Scope"
        },
        "turnId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "fence": {
          "$ref": "common.schema.json#/$defs/Fence"
        }
      },
      "required": [
        "protocolVersion",
        "scope",
        "turnId",
        "fence"
      ],
      "additionalProperties": false
    },
    "InputsResponse": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "common.schema.json#/$defs/Version"
        },
        "scope": {
          "$ref": "common.schema.json#/$defs/Scope"
        },
        "turnId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "pendingInputs": {
          "type": "array",
          "items": {
            "$ref": "recovery.schema.json#/$defs/PendingInput"
          },
          "maxItems": 4096
        }
      },
      "required": [
        "protocolVersion",
        "scope",
        "turnId",
        "pendingInputs"
      ],
      "additionalProperties": false
    },
    "CloseInputsReceipt": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "common.schema.json#/$defs/Version"
        },
        "scope": {
          "$ref": "common.schema.json#/$defs/Scope"
        },
        "turnId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "throughSequence": {
          "$ref": "common.schema.json#/$defs/UInt"
        }
      },
      "required": [
        "protocolVersion",
        "scope",
        "turnId",
        "throughSequence"
      ],
      "additionalProperties": false
    },
    "ReserveModelRequest": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "common.schema.json#/$defs/Version"
        },
        "scope": {
          "$ref": "common.schema.json#/$defs/Scope"
        },
        "turnId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "fence": {
          "$ref": "common.schema.json#/$defs/Fence"
        },
        "modelCallId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "model": {
          "$ref": "common.schema.json#/$defs/Id"
        }
      },
      "required": [
        "protocolVersion",
        "scope",
        "turnId",
        "fence",
        "modelCallId",
        "model"
      ],
      "additionalProperties": false
    },
    "ReserveModelReceipt": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "common.schema.json#/$defs/Version"
        },
        "scope": {
          "$ref": "common.schema.json#/$defs/Scope"
        },
        "turnId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "modelCallId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "outcome": {
          "const": "reserved"
        }
      },
      "required": [
        "protocolVersion",
        "scope",
        "turnId",
        "modelCallId",
        "outcome"
      ],
      "additionalProperties": false
    },
    "NextRequest": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "common.schema.json#/$defs/Version"
        },
        "harnessType": {
          "enum": [
            "agentscope-java",
            "pi",
            "pi-durable",
            "codex"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      },
      "required": [
        "protocolVersion",
        "harnessType",
        "limit"
      ],
      "additionalProperties": false
    },
    "Delivery": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "common.schema.json#/$defs/Scope"
        },
        "turnId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "trigger": {
          "$ref": "execution.schema.json#/$defs/Trigger"
        }
      },
      "required": [
        "scope",
        "turnId",
        "trigger"
      ],
      "additionalProperties": false
    },
    "NextResponse": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "common.schema.json#/$defs/Version"
        },
        "deliveries": {
          "type": "array",
          "items": {
            "$ref": "runtime.schema.json#/$defs/Delivery"
          },
          "maxItems": 4096
        }
      },
      "required": [
        "protocolVersion",
        "deliveries"
      ],
      "additionalProperties": false
    },
    "ConfigurationResponse": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "common.schema.json#/$defs/Version"
        },
        "scope": {
          "$ref": "common.schema.json#/$defs/Scope"
        },
        "turnId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "configuration": {
          "$ref": "runtime.schema.json#/$defs/RunConfiguration"
        },
        "identity": {
          "$ref": "runtime.schema.json#/$defs/ConfigurationIdentity"
        }
      },
      "required": [
        "protocolVersion",
        "scope",
        "turnId",
        "configuration",
        "identity"
      ],
      "additionalProperties": false
    },
    "ModelConfiguration": {
      "type": "object",
      "properties": {
        "provider": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "api": {
          "enum": [
            "openai-completions",
            "openai-responses",
            "anthropic-messages"
          ]
        },
        "baseUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "credentialEnv": {
          "type": "string",
          "pattern": "^(MANAGED_MODEL_|PI_MODEL_)[A-Z0-9_]+$"
        },
        "contextWindow": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "outputLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "reasoning": {
          "type": "boolean"
        },
        "cost": {
          "type": "object",
          "properties": {
            "input": {
              "type": "number",
              "minimum": 0
            },
            "output": {
              "type": "number",
              "minimum": 0
            },
            "cacheRead": {
              "type": "number",
              "minimum": 0
            },
            "cacheWrite": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "input",
            "output",
            "cacheRead",
            "cacheWrite"
          ],
          "additionalProperties": false
        },
        "parameters": {
          "type": "object",
          "properties": {
            "temperature": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "maxTokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000000
            },
            "reasoning": {
              "enum": [
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh"
              ]
            },
            "topP": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "parallelToolCalls": {
              "type": "boolean"
            },
            "toolChoice": {
              "enum": [
                "auto",
                "none",
                "required"
              ]
            }
          },
          "additionalProperties": false
        },
        "requestTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      },
      "required": [
        "provider",
        "id"
      ],
      "additionalProperties": false
    },
    "RunConfiguration": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string"
        },
        "cwd": {
          "type": "string"
        },
        "model": {
          "$ref": "runtime.schema.json#/$defs/ModelConfiguration"
        },
        "toolConfiguration": {
          "$ref": "common.schema.json#/$defs/ObjectRef"
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "$ref": "common.schema.json#/$defs/Id"
              },
              "operation": {
                "$ref": "common.schema.json#/$defs/Id"
              },
              "description": {
                "type": "string"
              },
              "parameters": {
                "type": "object"
              },
              "permission": {
                "enum": [
                  "always_allow",
                  "always_ask",
                  "deny"
                ]
              },
              "argumentEnvelope": {
                "type": "object"
              }
            },
            "required": [
              "name",
              "operation",
              "description",
              "parameters"
            ],
            "additionalProperties": false
          },
          "maxItems": 4096
        },
        "system": {
          "type": "string"
        },
        "maxModelCalls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "inlineWaitMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000
        }
      },
      "required": [
        "prompt",
        "cwd",
        "model",
        "toolConfiguration",
        "tools"
      ],
      "additionalProperties": false
    },
    "ConfigurationIdentity": {
      "type": "object",
      "properties": {
        "formatVersion": {
          "const": "managed-effective-agent-v1"
        },
        "harnessType": {
          "enum": [
            "pi",
            "pi-durable",
            "codex",
            "agentscope-java"
          ]
        },
        "agentId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "agentVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "sourceDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "effectiveDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "configurationDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "formatVersion",
        "harnessType",
        "agentId",
        "agentVersion",
        "sourceDigest",
        "effectiveDigest",
        "configurationDigest"
      ],
      "additionalProperties": false
    },
    "ModelBindingResponse": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": "0.1.0"
        },
        "scope": {
          "$ref": "common.schema.json#/$defs/Scope"
        },
        "turnId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "identity": {
          "$ref": "runtime.schema.json#/$defs/ConfigurationIdentity"
        },
        "configuration": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "mode": {
                  "const": "binding"
                },
                "model": {
                  "$ref": "runtime.schema.json#/$defs/ModelConfiguration"
                }
              },
              "required": [
                "mode",
                "model"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "const": "native"
                },
                "name": {
                  "$ref": "common.schema.json#/$defs/Id"
                }
              },
              "required": [
                "mode"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "protocolVersion",
        "scope",
        "turnId",
        "identity",
        "configuration"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "configuration": {
                "properties": {
                  "mode": {
                    "const": "native"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "identity": {
                "properties": {
                  "harnessType": {
                    "const": "agentscope-java"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "ReleaseReceipt": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "common.schema.json#/$defs/Version"
        },
        "scope": {
          "$ref": "common.schema.json#/$defs/Scope"
        },
        "turnId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "released": {
          "const": true
        }
      },
      "required": [
        "protocolVersion",
        "scope",
        "turnId",
        "released"
      ],
      "additionalProperties": false
    },
    "Notification": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "common.schema.json#/$defs/Scope"
        },
        "turnId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "trigger": {
          "$ref": "execution.schema.json#/$defs/Trigger"
        }
      },
      "required": [
        "scope",
        "turnId",
        "trigger"
      ],
      "additionalProperties": false
    }
  }
}
