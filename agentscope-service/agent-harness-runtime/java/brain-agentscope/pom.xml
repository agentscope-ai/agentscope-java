<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.agentcore.managed</groupId>
        <artifactId>managed-agents-harness-java</artifactId>
        <relativePath>../pom.xml</relativePath>
        <version>${revision}</version>
    </parent>

    <artifactId>managed-agents-agent-harness-runtime</artifactId>
    <packaging>jar</packaging>

    <name>Managed Agents - Agent Harness Runtime</name>
    <description>AgentScope Brain: turn consumption, native execution and recovery, Session Service integration</description>

    <dependencies>
        <dependency><groupId>io.agentscope</groupId><artifactId>agentscope-extensions-model-openai</artifactId><version>${agentscope.version}</version></dependency>
        <dependency><groupId>io.agentscope</groupId><artifactId>agentscope-extensions-model-openai-official</artifactId><version>${agentscope.version}</version></dependency>
        <dependency><groupId>io.agentscope</groupId><artifactId>agentscope-extensions-model-anthropic</artifactId><version>${agentscope.version}</version></dependency>
        <dependency><groupId>io.agentcore.managed</groupId><artifactId>managed-agents-harness-runtime-java</artifactId><version>${revision}</version></dependency>
        <dependency><groupId>io.agentcore.managed</groupId><artifactId>managed-agents-adapter-agentscope</artifactId><version>${revision}</version></dependency>
        <!-- Offline fixtures used by JEV Service integration tests. -->
        <dependency>
            <groupId>io.agentscope.examples</groupId>
            <artifactId>jev</artifactId>
            <version>${agentscope.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-jev</artifactId>
            <version>${agentscope.version}</version>
        </dependency>
        <dependency>
            <groupId>io.agentcore.managed</groupId>
            <artifactId>managed-agents-common</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-harness</artifactId>
        </dependency>

        <!-- ControlPlane transport and distributed-store adapters. -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-controlplane</artifactId>
        </dependency>

        <!-- Managed Environment type=sandbox → E2B cloud -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-sandbox-e2b</artifactId>
        </dependency>

        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-model-dashscope</artifactId>
        </dependency>

        <!-- JdbcStore-backed BaseStore for remote filesystem routes -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-jdbc</artifactId>
        </dependency>

        <!-- SQLite for FTS5 memory indexing (transitive use via harness extensions) -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.47.2.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- JDBC drivers (shared database across planes) -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.4.240</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring.boot.version}</version>
                <configuration>
                    <mainClass>io.agentcore.managed.server.AgentHarnessRuntimeApp</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
