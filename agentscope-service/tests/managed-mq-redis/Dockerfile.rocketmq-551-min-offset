# Test-only derivative. It is not an Apache RocketMQ release image.
ARG BASE_IMAGE=managed-test/rocketmq:5.5.1
FROM ${BASE_IMAGE} AS compile
USER root
COPY PopLiteMessageProcessor.java /tmp/lite-offset/PopLiteMessageProcessor.java
RUN mkdir -p /tmp/lite-offset/classes && \
    javac -source 8 -target 8 -cp '/home/rocketmq/rocketmq-5.5.1/lib/*' \
      -d /tmp/lite-offset/classes /tmp/lite-offset/PopLiteMessageProcessor.java

FROM ${BASE_IMAGE}
USER root
COPY --from=compile /tmp/lite-offset/classes /tmp/lite-offset/classes
RUN cd /tmp/lite-offset/classes && \
    jar uf /home/rocketmq/rocketmq-5.5.1/lib/rocketmq-broker-5.5.1.jar \
      org/apache/rocketmq/broker/processor && \
    rm -rf /tmp/lite-offset
LABEL managed.fixture.patch="lite-initial-offset-honors-consumeFromMinEnable"
USER 3000
