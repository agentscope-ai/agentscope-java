{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "type",
    "session_id",
    "created_at",
    "cursor",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "examples": [
        "item.delta",
        "required_action.created",
        "step.failed",
        "turn.partial_succeeded"
      ]
    },
    "created_at": {
      "type": "integer"
    },
    "cursor": {
      "type": "string"
    },
    "data": {
      "type": "object"
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "turn_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "description": "Committed Session or Turn event. Ignore unknown event types while advancing the cursor."
}
