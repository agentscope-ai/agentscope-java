# Migration-only Secret. Never attach this Secret to ordinary service workloads.
# Replace placeholders outside Git; URI passwords must be URL encoded.
CONTROL_PLANE_PRODUCT_DSN=postgres://agentscope_owner:URL_ENCODED_OWNER_PASSWORD@postgres.example:5432/agentscope?sslmode=require
CONTROL_PLANE_STORAGE_DSN=postgres://agentscope_owner:URL_ENCODED_OWNER_PASSWORD@postgres.example:5432/agentscope?sslmode=require&search_path=rt
BUILDER_PORTAL_DB_URL=jdbc:postgresql://postgres.example:5432/agentscope?currentSchema=portal&sslmode=require
BUILDER_PORTAL_DB_USER=agentscope_owner
BUILDER_PORTAL_DB_PASSWORD=REPLACE_OWNER_PASSWORD
BUILDER_DB_URL=jdbc:postgresql://postgres.example:5432/agentscope?currentSchema=dp&sslmode=require
BUILDER_DB_USER=agentscope_owner
BUILDER_DB_PASSWORD=REPLACE_OWNER_PASSWORD
BUILDER_MANAGED_DB_URL=jdbc:postgresql://postgres.example:5432/agentscope?currentSchema=ma&sslmode=require
BUILDER_MANAGED_DB_USER=agentscope_owner
BUILDER_MANAGED_DB_PASSWORD=REPLACE_OWNER_PASSWORD
