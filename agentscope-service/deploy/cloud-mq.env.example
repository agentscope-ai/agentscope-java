# Optional MQ authentication for an explicitly configured installation.
# Self-hosted deployments continue to use deploy/kubernetes.env.example.
BUILDER_MANAGED_MQ_ENDPOINTS=rocketmq-proxy.example:8081
BUILDER_MANAGED_MQ_ACCESS_KEY=REPLACE_WITH_INSTANCE_USERNAME
BUILDER_MANAGED_MQ_SECRET_KEY=REPLACE_WITH_INSTANCE_PASSWORD
