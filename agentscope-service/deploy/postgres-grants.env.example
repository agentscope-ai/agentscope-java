# Owner-only input for psql and postgres-roles.sh. Keep the private copy outside Git.
# These are raw passwords, matching the workload and migration connection templates.
PGHOST=postgres.example
PGPORT=5432
PGDATABASE=agentscope
PGUSER=agentscope_owner
PGPASSWORD=REPLACE_OWNER_PASSWORD
PGSSLMODE=require
CONTROL_DB_PASSWORD=REPLACE_CONTROL_PASSWORD
PORTAL_DB_PASSWORD=REPLACE_PORTAL_PASSWORD
DATA_DB_PASSWORD=REPLACE_DATA_PASSWORD
HANDS_DB_PASSWORD=REPLACE_HANDS_PASSWORD
