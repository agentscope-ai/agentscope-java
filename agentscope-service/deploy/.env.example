# Use the registry namespace and version from the release notes.
IMAGE_REPOSITORY=registry.example.com/your-namespace
SERVICE_VERSION=2.0.3-rc.1
# init-env.sh creates random values. Keep these stable across upgrades.
POSTGRES_DB=agentscope
POSTGRES_PASSWORD=
BUILDER_JWT_SECRET=
BUILDER_INTERNAL_TOKEN=
BUILDER_VAULT_MASTER_KEY=
AISTIO_BOOTSTRAP_ADMIN=admin
AISTIO_BOOTSTRAP_PASSWORD=
BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=18080
BUILDER_OAUTH_PUBLIC_URL=http://localhost:18080
BUILDER_ALLOW_LOCAL_ENVIRONMENT=false
DASHSCOPE_API_KEY=
BUILDER_E2B_API_KEY=
