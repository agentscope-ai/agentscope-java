# Use the registry namespace and version from the release notes.
IMAGE_REPOSITORY=registry.example.com/your-namespace
SERVICE_VERSION=2.1.0-BETA1
# init-env.sh creates random values. Keep these stable across upgrades.
POSTGRES_DB=agentscope
POSTGRES_PASSWORD=
CONTROL_DB_PASSWORD=
PORTAL_DB_PASSWORD=
DATA_DB_PASSWORD=
HANDS_DB_PASSWORD=
BUILDER_JWT_SECRET=
BUILDER_INTERNAL_TOKEN=
BUILDER_VAULT_MASTER_KEY=
# Redis and RocketMQ 5.5.1 Cluster Proxy are operated separately; addresses must be reachable
# from service containers. Create five Lite parents and FIFO / Shared / wildcard groups first.
BUILDER_MANAGED_REDIS_URI=redis://redis.example:6379
BUILDER_MANAGED_MQ_ENDPOINTS=rocketmq-proxy.example:8081
BUILDER_MANAGED_MQ_TURN_TOPIC=ma_turns_v3
BUILDER_MANAGED_MQ_TOOL_EVENT_TOPIC=ma_tool_events_v3
BUILDER_MANAGED_MQ_TOOL_EXECUTE_TOPIC=ma_tool_execute_v1
BUILDER_MANAGED_MQ_TOOL_CONTROL_TOPIC=ma_tool_control_v1
BUILDER_MANAGED_MQ_TOOL_EXECUTE_GROUP=ma_hands_execute_v1
BUILDER_MANAGED_MQ_TOOL_CONTROL_GROUP=ma_hands_control_v1
BUILDER_MANAGED_MQ_RESUME_TOPIC=ma_turn_resumes_v3
BUILDER_MANAGED_MQ_BRAIN_GROUP=ma_brain_v3
BUILDER_MANAGED_MQ_RESUME_GROUP=ma_brain_resumes_v3
BUILDER_MANAGED_MQ_TOOL_EVENTS_GROUP=ma_brain_tool_events_v3
BUILDER_MANAGED_MQ_CACHE_MESSAGES=512
BUILDER_MANAGED_MQ_CACHE_BYTES=33554432
BUILDER_MANAGED_MQ_SSL=false
# Optional authentication: supply both values, or leave both empty.
BUILDER_MANAGED_MQ_ACCESS_KEY=
BUILDER_MANAGED_MQ_SECRET_KEY=
# Active Harness workers are independent of Turn and Resume callback capacity.
BUILDER_MANAGED_CONCURRENCY=32
BUILDER_MANAGED_TURN_CALLBACKS=64
BUILDER_MANAGED_RESUME_CALLBACKS=64
BUILDER_MANAGED_TOOL_EVENT_CONCURRENCY=16
BUILDER_MANAGED_CHILD_CONTROL_CONCURRENCY=4
BUILDER_MANAGED_TOOL_CONCURRENCY=16
BUILDER_MANAGED_TOOL_CONTROL_CONCURRENCY=4
BUILDER_PORTAL_DB_POOL_SIZE=10
BUILDER_DATA_DB_POOL_SIZE=10
BUILDER_HANDS_DB_POOL_SIZE=16
BUILDER_USER_FILES_ENABLED=true
CONTROL_PLANE_BOOTSTRAP_ADMIN=admin
CONTROL_PLANE_BOOTSTRAP_PASSWORD=
BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=18080
BUILDER_OAUTH_PUBLIC_URL=http://localhost:18080
BUILDER_LOCAL_DEV=false
# Privileged native trace requires a current human administrator and Session permission.
BUILDER_SESSION_TRACE_ENABLED=false
# Additional database connections per Dataplane replica, separate from its JPA pool.
BUILDER_RUNTIME_NATIVE_LOG_CONNECTIONS=8
BUILDER_ALLOW_LOCAL_ENVIRONMENT=false
DASHSCOPE_API_KEY=
# ACS SandboxManager tenant API key (not its admin key). Only cloud uses this fallback.
BUILDER_E2B_API_KEY=

# Outbound Session webhooks: exact allowed HTTPS host names, port 443.
BUILDER_WEBHOOK_ALLOWED_HOSTS=
BUILDER_WEBHOOK_SLOTS=8
