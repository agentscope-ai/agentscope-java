# Use the registry namespace and version from the release notes.
IMAGE_REPOSITORY=registry.example.com/your-namespace
SERVICE_VERSION=2.1.0-BETA1
# init-env.sh creates random values. Keep these stable across upgrades.
POSTGRES_DB=managed_agents
POSTGRES_PASSWORD=
CONTROL_DB_PASSWORD=
AGENT_SERVICE_DB_PASSWORD=
AGENT_HARNESS_RUNTIME_DB_PASSWORD=
TOOL_WORKER_DB_PASSWORD=
MANAGED_AGENTS_JWT_SECRET=
MANAGED_AGENTS_INTERNAL_TOKEN=
MANAGED_AGENTS_VAULT_MASTER_KEY=
# Redis and RocketMQ 5.5.1 Cluster Proxy are operated separately; addresses must be reachable
# from service containers. Create four Lite parents and FIFO / Shared / wildcard groups first.
MANAGED_AGENTS_RUNTIME_REDIS_URI=redis://redis.example:6379
MANAGED_AGENTS_RUNTIME_MQ_ENDPOINTS=rocketmq-proxy.example:8081
MANAGED_AGENTS_RUNTIME_MQ_TURN_TOPIC=ma_turns_v3
MANAGED_AGENTS_RUNTIME_MQ_TOOL_EVENT_TOPIC=ma_tool_events_v3
MANAGED_AGENTS_RUNTIME_MQ_RESUME_TOPIC=ma_turn_resumes_v3
MANAGED_AGENTS_RUNTIME_MQ_HARNESS_RUNTIME_GROUP=ma_brain_v3
MANAGED_AGENTS_RUNTIME_MQ_RESUME_GROUP=ma_brain_resumes_v3
MANAGED_AGENTS_RUNTIME_MQ_TOOL_EVENTS_GROUP=ma_brain_tool_events_v3
MANAGED_AGENTS_RUNTIME_MQ_CACHE_MESSAGES=512
MANAGED_AGENTS_RUNTIME_MQ_CACHE_BYTES=33554432
MANAGED_AGENTS_RUNTIME_MQ_SSL=false
# Active Harness workers are independent of held original Turn and Resume callbacks.
MANAGED_AGENTS_RUNTIME_CONCURRENCY=32
MANAGED_AGENTS_RUNTIME_TURN_CALLBACKS=64
MANAGED_AGENTS_RUNTIME_RESUME_CALLBACKS=64
CONTROL_PLANE_BOOTSTRAP_ADMIN=admin
CONTROL_PLANE_BOOTSTRAP_PASSWORD=
BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=18080
MANAGED_AGENTS_OAUTH_PUBLIC_URL=http://localhost:18080
MANAGED_AGENTS_LOCAL_DEV=false
# Privileged native trace requires a current human administrator and Session permission.
MANAGED_AGENTS_SESSION_TRACE_ENABLED=false
# Additional database connections per Dataplane replica, separate from its JPA pool.
MANAGED_AGENTS_RUNTIME_NATIVE_LOG_CONNECTIONS=8
MANAGED_AGENTS_ALLOW_LOCAL_ENVIRONMENT=false
DASHSCOPE_API_KEY=
# ACS SandboxManager tenant API key (not its admin key). Only cloud uses this fallback.
MANAGED_AGENTS_E2B_API_KEY=

# Outbound Session webhooks: exact allowed HTTPS host names, port 443.
MANAGED_AGENTS_WEBHOOK_ALLOWED_HOSTS=
MANAGED_AGENTS_WEBHOOK_SLOTS=8

# Required schema 3 projection backend; initialize before starting services.
# Use a separate query database, never the execution database URL.
MANAGED_AGENTS_QUERY_STORE_ENABLED=true
MANAGED_AGENTS_QUERY_STORE_PROVIDER=postgres
MANAGED_AGENTS_QUERY_STORE_JDBC_URL=jdbc:postgresql://query-db.example:5432/managed_agents_query
MANAGED_AGENTS_QUERY_STORE_USER=managed_agents_query
MANAGED_AGENTS_QUERY_STORE_PASSWORD=replace-with-query-password
MANAGED_AGENTS_QUERY_STORE_SIGNING_KEY=replace-with-at-least-32-random-characters
MANAGED_AGENTS_QUERY_STORE_BUILD=v3
MANAGED_AGENTS_RUNTIME_MQ_PROJECTION_TOPIC=ma_session_projections_v3
MANAGED_AGENTS_RUNTIME_MQ_PROJECTION_GROUP=ma_session_projections_v3
