# Copy outside Git, replace every placeholder, and create a Secret with --from-env-file.
# Initialize cp, rt, portal, dp, ma with a separate migration Secret and apply business-role grants.
# This combined template uses business accounts only. Per-component existingSecret values can
# separate database credentials. Control owns both cp and rt schemas.
# URI passwords must be URL encoded; JDBC credentials are supplied separately.
CONTROL_PLANE_PRODUCT_DSN=postgres://agentscope_control:URL_ENCODED_CONTROL_PASSWORD@postgres.example:5432/agentscope?sslmode=require
CONTROL_PLANE_STORAGE_DSN=postgres://agentscope_control:URL_ENCODED_CONTROL_PASSWORD@postgres.example:5432/agentscope?sslmode=require&search_path=rt
BUILDER_PORTAL_DB_URL=jdbc:postgresql://postgres.example:5432/agentscope?currentSchema=portal&sslmode=require
BUILDER_PORTAL_DB_USER=agentscope_portal
BUILDER_PORTAL_DB_PASSWORD=REPLACE_PORTAL_PASSWORD
BUILDER_DB_URL=jdbc:postgresql://postgres.example:5432/agentscope?currentSchema=dp&sslmode=require
BUILDER_DB_USER=agentscope_data
BUILDER_DB_PASSWORD=REPLACE_DATA_PASSWORD
BUILDER_LOCAL_DEV=false
# Privileged native trace requires a current human administrator and Session permission.
BUILDER_SESSION_TRACE_ENABLED=false
BUILDER_JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
BUILDER_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
BUILDER_VAULT_MASTER_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
BUILDER_HANDS_DB_URL=jdbc:postgresql://postgres.example:5432/agentscope?currentSchema=ma&sslmode=require
BUILDER_HANDS_DB_USER=agentscope_hands
BUILDER_HANDS_DB_PASSWORD=REPLACE_HANDS_PASSWORD
BUILDER_MANAGED_REDIS_URI=rediss://redis.example:6379
BUILDER_MANAGED_MQ_ENDPOINTS=rocketmq-proxy.example:8081
CONTROL_PLANE_BOOTSTRAP_ADMIN=admin
CONTROL_PLANE_BOOTSTRAP_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD_12_TO_72_BYTES
DASHSCOPE_API_KEY=
BUILDER_E2B_API_KEY=
