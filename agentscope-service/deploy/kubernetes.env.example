# Copy outside Git, replace every placeholder, and create a Secret with --from-env-file.
# Initialize cp, rt, dp schemas as the application DB owner using postgres-init.sql.
# URI passwords must be URL encoded; JDBC credentials are supplied separately.
AISTIO_PRODUCT_DSN=postgres://agentscope:URL_ENCODED_PASSWORD@postgres.example:5432/agentscope?sslmode=require
AISTIO_STORAGE_DSN=postgres://agentscope:URL_ENCODED_PASSWORD@postgres.example:5432/agentscope?sslmode=require&search_path=rt
BUILDER_DB_URL=jdbc:postgresql://postgres.example:5432/agentscope?currentSchema=dp&sslmode=require
BUILDER_DB_USER=agentscope
BUILDER_DB_PASSWORD=REPLACE_DB_PASSWORD
BUILDER_JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
BUILDER_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
BUILDER_VAULT_MASTER_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
AISTIO_BOOTSTRAP_ADMIN=admin
AISTIO_BOOTSTRAP_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD_12_TO_72_BYTES
DASHSCOPE_API_KEY=
BUILDER_E2B_API_KEY=
