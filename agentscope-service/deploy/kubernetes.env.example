# Copy outside Git, replace every placeholder, and create a Secret with --from-env-file.
# Initialize cp, rt, portal, dp, ma with a separate migration Secret and apply business-role grants.
# This combined template uses business accounts only. Per-component existingSecret values can
# separate database credentials. Control owns both cp and rt schemas.
# URI passwords must be URL encoded; JDBC credentials are supplied separately.
CONTROL_PLANE_PRODUCT_DSN=postgres://managed_agents_control:URL_ENCODED_CONTROL_PASSWORD@pgm-bp10083t3nwu553v.pg.rds.aliyuncs.com:5432/managed_agents?sslmode=require
CONTROL_PLANE_STORAGE_DSN=postgres://managed_agents_control:URL_ENCODED_CONTROL_PASSWORD@pgm-bp10083t3nwu553v.pg.rds.aliyuncs.com:5432/managed_agents?sslmode=require&search_path=rt
MANAGED_AGENTS_AGENT_SERVICE_DB_URL=jdbc:postgresql://pgm-bp10083t3nwu553v.pg.rds.aliyuncs.com:5432/managed_agents?currentSchema=portal&sslmode=require
MANAGED_AGENTS_AGENT_SERVICE_DB_USER=managed_agents_agent_service
MANAGED_AGENTS_AGENT_SERVICE_DB_PASSWORD=REPLACE_AGENT_SERVICE_PASSWORD
MANAGED_AGENTS_AGENT_HARNESS_RUNTIME_DB_URL=jdbc:postgresql://pgm-bp10083t3nwu553v.pg.rds.aliyuncs.com:5432/managed_agents?currentSchema=dp&sslmode=require
MANAGED_AGENTS_AGENT_HARNESS_RUNTIME_DB_USER=managed_agents_agent_harness_runtime
MANAGED_AGENTS_AGENT_HARNESS_RUNTIME_DB_PASSWORD=REPLACE_AGENT_HARNESS_RUNTIME_PASSWORD
MANAGED_AGENTS_LOCAL_DEV=false
# Privileged native trace requires a current human administrator and Session permission.
MANAGED_AGENTS_SESSION_TRACE_ENABLED=false
MANAGED_AGENTS_JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
MANAGED_AGENTS_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
MANAGED_AGENTS_VAULT_MASTER_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
MANAGED_AGENTS_TOOL_WORKER_DB_URL=jdbc:postgresql://pgm-bp10083t3nwu553v.pg.rds.aliyuncs.com:5432/managed_agents?currentSchema=ma&sslmode=require
MANAGED_AGENTS_TOOL_WORKER_DB_USER=managed_agents_tool_worker
MANAGED_AGENTS_TOOL_WORKER_DB_PASSWORD=REPLACE_TOOL_WORKER_PASSWORD
MANAGED_AGENTS_RUNTIME_REDIS_URI=redis://ma_runtime:URL_ENCODED_REDIS_PASSWORD@r-bp1m16nw61zguewk63.redis.rds.aliyuncs.com:6379/0
# ACS cloud MQ endpoint. Auth is supplied by the separate managed-agents-cloud-mq Secret.
# Helm loads that Secret after this workload Secret for the three MQ roles.
MANAGED_AGENTS_RUNTIME_MQ_ENDPOINTS=rmq-cn-mhb50f8n501-vpc.cn-hangzhou.rmq.aliyuncs.com:8080
CONTROL_PLANE_BOOTSTRAP_ADMIN=admin
CONTROL_PLANE_BOOTSTRAP_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD_12_TO_72_BYTES
DASHSCOPE_API_KEY=
MANAGED_AGENTS_E2B_API_KEY=

# Required schema 3 projection backend; initialize before starting services.
# Use a separate query database, never the execution database URL.
MANAGED_AGENTS_QUERY_STORE_ENABLED=true
MANAGED_AGENTS_QUERY_STORE_PROVIDER=postgres
MANAGED_AGENTS_QUERY_STORE_JDBC_URL=jdbc:postgresql://query-db.example:5432/managed_agents_query
MANAGED_AGENTS_QUERY_STORE_USER=managed_agents_query
MANAGED_AGENTS_QUERY_STORE_PASSWORD=replace-with-query-password
MANAGED_AGENTS_QUERY_STORE_SIGNING_KEY=replace-with-at-least-32-random-characters
MANAGED_AGENTS_QUERY_STORE_BUILD=v3
MANAGED_AGENTS_RUNTIME_MQ_PROJECTION_TOPIC=ma_session_projections_v3
MANAGED_AGENTS_RUNTIME_MQ_PROJECTION_GROUP=ma_session_projections_v3
