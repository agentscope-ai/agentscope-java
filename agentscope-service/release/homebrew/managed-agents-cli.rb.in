class ManagedAgentsCli < Formula
  desc "Managed Agents CLI and Runtime Host"
  homepage "https://gitlab.alibaba-inc.com/ken.lj/agentcore-managed-agents"
  version "@VERSION@"
  license "Apache-2.0"

  on_macos do
    on_arm do
      url "@RELEASE_BASE_URL@/managed-agents-cli-@VERSION@-darwin-arm64.tar.gz"
      sha256 "@SHA256_DARWIN_ARM64@"
    end
    on_intel do
      url "@RELEASE_BASE_URL@/managed-agents-cli-@VERSION@-darwin-amd64.tar.gz"
      sha256 "@SHA256_DARWIN_AMD64@"
    end
  end

  on_linux do
    on_arm do
      url "@RELEASE_BASE_URL@/managed-agents-cli-@VERSION@-linux-arm64.tar.gz"
      sha256 "@SHA256_LINUX_ARM64@"
    end
    on_intel do
      url "@RELEASE_BASE_URL@/managed-agents-cli-@VERSION@-linux-amd64.tar.gz"
      sha256 "@SHA256_LINUX_AMD64@"
    end
  end

  def install
    bin.install "mactl", "managed-agents-runtime-host"
    pkgshare.install "README.md"
  end

  test do
    assert_match "mactl version 2.1.0-BETA1", shell_output("#{bin}/mactl version")
    assert_match "-control-plane", shell_output("#{bin}/managed-agents-runtime-host -help 2>&1")
  end
end
