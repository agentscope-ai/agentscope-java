# Fast local packaging after CGO_ENABLED=0 GOOS=linux builds and console build.
# Build context is managed-agents; select target control.
FROM alpine:3.21 AS base
RUN test -s /etc/ssl/cert.pem \
    && addgroup -g 65532 managed-agents \
    && adduser -D -u 65532 -G managed-agents -h /data managed-agents \
    && mkdir -p /data/workspaces /data/artifacts \
    && chown -R 65532:65532 /data
USER 65532:65532

FROM base AS control
COPY control-plane/target/local-linux/control-plane /control-plane
COPY control-plane/ui /ui
ENV CONTROL_PLANE_STATIC_DIR=/ui CONTROL_PLANE_WORKSPACE_ROOT=/data/workspaces
EXPOSE 8081
ENTRYPOINT ["/control-plane"]
