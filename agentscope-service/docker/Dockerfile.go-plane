# Fast local packaging after CGO_ENABLED=0 GOOS=linux builds and frontend build.
# Build context is agentscope-service; select target control.
FROM alpine:3.21 AS base
RUN test -s /etc/ssl/cert.pem \
    && addgroup -g 65532 agentscope \
    && adduser -D -u 65532 -G agentscope -h /data agentscope \
    && mkdir -p /data/workspaces /data/artifacts \
    && chown -R 65532:65532 /data
USER 65532:65532

FROM base AS control
COPY service-controlplane/target/local-linux/service-controlplane /service-controlplane
COPY service-controlplane/ui /ui
ENV CONTROL_PLANE_STATIC_DIR=/ui CONTROL_PLANE_WORKSPACE_ROOT=/data/workspaces
EXPOSE 8081
ENTRYPOINT ["/service-controlplane"]
