# Build from the monorepo root; no generated console files are required in Git.
FROM --platform=$BUILDPLATFORM node:22-bookworm-slim AS console
WORKDIR /src/frontend
COPY agentscope-service/frontend/package*.json ./
# The checked-in lockfile may contain developer-only Alibaba registry tarball URLs.
# Normalize those URLs in the image layer so builds also work outside that network.
RUN sed -i 's#https://registry.anpm.alibaba-inc.com/#https://registry.npmjs.org/#g' package-lock.json \
    && npm config set registry https://registry.npmjs.org/ \
    && npm ci --no-audit --no-fund
COPY agentscope-service/frontend/ ./
RUN npm run build

FROM --platform=$BUILDPLATFORM golang:1.26 AS build
ARG VERSION=2.1.0-BETA1
ARG GIT_COMMIT=unknown
ARG TARGETOS=linux
ARG TARGETARCH
WORKDIR /src
COPY agentscope-service/service-controlplane/go.mod agentscope-service/service-controlplane/go.sum ./
RUN go mod download
COPY agentscope-service/service-controlplane/ ./
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags="-s -w -X github.com/agentscope-ai/agentscope-java/agentscope-service/service-controlplane/v2/internal/version.Version=$VERSION -X main.gitCommit=$GIT_COMMIT" -o /out/service-controlplane ./cmd/service-controlplane
RUN mkdir -p /out/data/workspaces /out/data/artifacts

FROM gcr.io/distroless/static:nonroot
COPY --from=build /out/service-controlplane /service-controlplane
COPY --from=console /src/service-controlplane/ui /ui
COPY --from=build --chown=65532:65532 /out/data /data
ENV CONTROL_PLANE_STATIC_DIR=/ui CONTROL_PLANE_WORKSPACE_ROOT=/data/workspaces
USER 65532:65532
EXPOSE 8081
ENTRYPOINT ["/service-controlplane"]
