<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.agentscope</groupId>
        <artifactId>agentscope-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>agentscope-durable</artifactId>
    <packaging>pom</packaging>
    <name>AgentScope Java - Durable</name>
    <description>Embeddable durable Agent execution, native recovery and remote execution components</description>

    <modules>
        <module>durable-runtime</module>
        <module>durable-adapters</module>
        <module>durable-worker</module>
    </modules>

    <properties>
        <!-- Development API; publication is a separate explicit release action. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <java-json-canonicalization.version>1.1</java-json-canonicalization.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.erdtman</groupId>
                <artifactId>java-json-canonicalization</artifactId>
                <version>${java-json-canonicalization.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <profiles>
        <profile>
            <id>durable-standalone</id>
            <modules>
                <module>../agentscope-extensions/agentscope-extensions-durable-jdbc</module>
                <module>../agentscope-extensions/agentscope-extensions-durable-http</module>
                <module>../agentscope-extensions/agentscope-extensions-durable-sandbox</module>
                <module>../agentscope-extensions/agentscope-extensions-durable-rocketmq</module>
                <module>../agentscope-extensions/agentscope-extensions-durable-objects</module>
                <module>../agentscope-extensions/agentscope-extensions-durable-mcp</module>
                <module>../agentscope-examples/durable</module>
            </modules>
        </profile>
    </profiles>
</project>
