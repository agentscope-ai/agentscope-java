<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.agentscope</groupId>
        <artifactId>agentscope-examples</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>durable</artifactId>
    <packaging>pom</packaging>
    <name>AgentScope Durable - Java Examples</name>
    <description>Spring Boot examples for Durable Runtime and Hands integration</description>
    <modules>
        <module>integrated</module>
        <module>brain-hands</module>
    </modules>
    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <spring.boot.version>4.0.4</spring.boot.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <profiles>
        <profile>
            <id>skip-durable-windows-tests</id>
            <activation>
                <property>
                    <name>skipDurableWindowsTests</name>
                    <value>true</value>
                </property>
            </activation>
            <properties>
                <skipTests>true</skipTests>
            </properties>
        </profile>
    </profiles>
</project>
